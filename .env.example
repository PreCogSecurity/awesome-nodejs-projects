# Copy to `.env` if you need to override the defaults. Compose reads this file
# automatically; every variable below is optional and its default is already the
# safe value.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, tokens or host paths.

# UID:GID the `verify` service runs as. Must match the unprivileged `node` user
# baked into the image (1000:1000) so that the read-only root filesystem and
# tmpfs mounts stay usable. Raise it if your host has a conflicting uid 1000.
APP_UID=1000

# GID counterpart of APP_UID; see above.
APP_GID=1000
